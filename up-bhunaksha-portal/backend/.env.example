# Backend port (default 4000)
PORT=4000

# Comma-separated list of allowed origins. Use "*" in dev, your real domain
# in production. Default already covers Next.js dev ports 3000 and 3001.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Cache TTL for level data, in seconds (default 7 days). Plot lookups are cached forever.
LEVEL_TTL_SECONDS=604800
